---
import HamburgerRight from "@images/burger-menu-right.svg";
import Close from "@images/close.svg";
---

<header class="bg-indigo-900">
  <div class="container mx-auto flex flex-row justify-between text-white">
    <div class="my-auto w-fit"><a href="/" tabindex="0" class="outline-0">Chris Kraft</a></div>
    <nav class="w-fit">
      <!-- Hamburger -->
      <button class="md:hidden absolute top-0 right-0 hover:cursor-pointer w-12 h-14 p-2 z-10 btn-hamburger nav-btn">
        <HamburgerRight fill="#ffffff" width={32} height={32} />
      </button>
      <!-- Close -->
      <button class="md:hidden absolute top-0 right-0 hover:cursor-pointer w-12 h-14 p-2 z-20 btn-close nav-btn" tabindex="0">
        <Close stroke="#ffffff" width={32} height={32} />
      </button>
      <div class="hidden absolute z-40 top-14 right-0 left-0 md:inline md:relative md:top-[unset] md:right-[unset] md:left-[unset] md:z-[unset] bg-indigo-900 nav-container">
        <ul class="flex flex-col md:flex-row gap">
          <li><a tabindex="0" class="outline-0" href="/about">About</a></li>
          <li><a tabindex="0" class="outline-0" href="/projects">Projects</a></li>
          <li><a tabindex="0" class="outline-0" href="/other-work">Other Work</a></li>
          <li><a tabindex="0" class="outline-0" href="/contact">Contact</a></li>
        </ul>
      </div>
    </nav>
  </div>
</header>
<style>
  a {
    display: block;
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    text-transform: uppercase;
    letter-spacing: 0.025rem;
    &:hover,
    &:focus {
      border-bottom: 4px solid var(--color-white);
    }
    &,
    &:hover,
    &:focus {
      transition: all 0.3s;
    }
  }
  body {
    .btn-close {
      display: none;
    }
    &.mobile-open {
      /* overflow: hidden; */
      .nav-container,
      .btn-close {
        display: block;
      }
      .btn-hamburger {
        display: none;
      }
    }
  }
</style>
<script>
  const navBtns = document.querySelectorAll(".nav-btn");
  const bodyElement = document.body;

  const toggleMobile = function () {
    bodyElement.classList.toggle("mobile-open");
  };

  navBtns.forEach((btn) => {
    btn.addEventListener("click", function () {
      toggleMobile();
    });
  });
  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && bodyElement.classList.contains("mobile-open")) {
      toggleMobile();
    }
  });
  window.onscroll = function () {
    if (bodyElement.classList.contains("mobile-open")) {
      bodyElement.classList.remove("mobile-open");
    }
  };
</script>
