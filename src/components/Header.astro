---

---

<header class="bg-indigo-900">
  <div class="container mx-auto flex flex-row justify-between text-white">
    <div class="my-auto w-fit"><a href="/" tabindex="0">Chris Kraft</a></div>
    <nav class="w-fit">
      <!-- Hamburger -->
      <button class="md:hidden absolute top-0 right-0 hover:cursor-pointer w-12 h-14 p-2 z-10 btn-hamburger nav-btn">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M4 5C3.44772 5 3 5.44772 3 6C3 6.55228 3.44772 7 4 7H20C20.5523 7 21 6.55228 21 6C21 5.44772 20.5523 5 20 5H4ZM7 12C7 11.4477 7.44772 11 8 11H20C20.5523 11 21 11.4477 21 12C21 12.5523 20.5523 13 20 13H8C7.44772 13 7 12.5523 7 12ZM13 18C13 17.4477 13.4477 17 14 17H20C20.5523 17 21 17.4477 21 18C21 18.5523 20.5523 19 20 19H14C13.4477 19 13 18.5523 13 18Z" fill="#ffffff"></path>
        </svg>
      </button>
      <!-- Close -->
      <button class="md:hidden absolute top-0 right-0 hover:cursor-pointer w-12 h-14 p-2 z-20 btn-close nav-btn" tabindex="0">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path id="Vector" d="M18 18L12 12M12 12L6 6M12 12L18 6M12 12L6 18" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </svg>
      </button>
      <div class="hidden absolute z-0 top-14 right-0 left-0 md:inline md:relative md:top-[unset] md:right-[unset] md:left-[unset] md:z-[unset] bg-indigo-900 nav-container">
        <ul class="flex flex-col md:flex-row gap">
          <li><a tabindex="0" class="outline-0" href="/about">About</a></li>
          <li><a tabindex="0" class="outline-0" href="/projects">Projects</a></li>
          <li><a tabindex="0" class="outline-0" href="/other-work">Other Work</a></li>
          <li><a tabindex="0" class="outline-0" href="/contact">Contact</a></li>
        </ul>
      </div>
    </nav>
  </div>
</header>
<style>
  a {
    display: block;
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    border-top: 4px solid transparent;
    border-bottom: 4px solid transparent;
    text-transform: uppercase;
    letter-spacing: 0.025rem;
    &:hover,
    &:focus {
      border-bottom: 4px solid var(--color-white);
    }
    &,
    &:hover,
    &:focus {
      transition: all 0.3s;
    }
  }
  body {
    .btn-close {
      display: none;
    }
    &.mobile-open {
      /* overflow: hidden; */
      .nav-container,
      .btn-close {
        display: block;
      }
      .btn-hamburger {
        display: none;
      }
    }
  }
</style>
<script>
  const navBtns = document.querySelectorAll(".nav-btn");
  const bodyElement = document.body;

  const toggleMobile = function () {
    bodyElement.classList.toggle("mobile-open");
  };

  navBtns.forEach((btn) => {
    btn.addEventListener("click", function () {
      toggleMobile();
    });
  });
  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape" && bodyElement.classList.contains("mobile-open")) {
      toggleMobile();
    }
  });
  window.onscroll = function () {
    if (bodyElement.classList.contains("mobile-open")) {
      bodyElement.classList.remove("mobile-open");
    }
  };
</script>
