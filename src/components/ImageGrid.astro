---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const allOtherWork = await getCollection("otherwork");
const images = allOtherWork[0].data.images;
---

<div class="columns-2 md:columns-4 gap-4 space-y-4">
  {images.map((image, index) => <Image src={image.src} alt={image.alt} loading="eager" data-index={index} />)}
</div>
