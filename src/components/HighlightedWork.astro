---
import ProjectSection from "./ProjectSection.astro";
import UNJSPF from "@assets/images/work/UNJSPF.png";
import RRS from "@assets/images/work/RRS.png";
import DT from "@assets/images/work/DT.png";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-col gap-20">
  <ProjectSection slug="/work/unjspf" imgSRC={UNJSPF} imgALT="Responsive UNJSPF homepage providing pension information and member services" title="United Nations Joint Staff Pension Fund Website Modernization">
    <p class="mb-[1lh]">Modernized a large, content-heavy public website by improving structure, accessibility, and editorial workflows through scalable templates and admin tools.</p>
    <LinkButton slug="/work/unjspf" slot="LinkButton">Learn about the <abbr title="United Nations Joint Staff Pension Fund">UNJSPF</abbr> project</LinkButton>
  </ProjectSection>
  <hr class="text-indigo-200" />
  <ProjectSection imgSRC={RRS} imgALT="Responsive Redi-Rock Structures website showcasing retaining wall solutions" title="Redi-Rock Structures Website" reverse="true">
    <p class="mb-[1lh]">Led a full website rebuild focused on content structure, usability, and sales enablement, delivered as a scalable WordPress platform.</p>
    <LinkButton slug="/work/rrs" slot="LinkButton">Learn about the <abbr title="Redi-Rock Structures">RRS</abbr> project</LinkButton>
  </ProjectSection>
  <hr class="text-indigo-200" />
  <ProjectSection imgSRC={DT} imgALT="Responsive design for DeveloperTown core values highlighting Take Ownership and Be Curious" title="DeveloperTown Values Website">
    <p class="mb-[1lh]">Defined structure and accessibility in collaboration with designers, then built a production-ready front end with <a href="https://astro.build/" target="_blank">Astro</a> and <a href="https://tailwindcss.com/" target="_blank">Tailwind</a>.</p>
    <LinkButton slug="/work/dt-values" slot="LinkButton">Learn about the <abbr title="DeveloperTown">DT</abbr> Values project</LinkButton>
  </ProjectSection>
</div>
