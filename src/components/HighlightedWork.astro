---
import ProjectSection from "./ProjectSection.astro";
import UNJSPF from "@assets/images/projects/UNJSPF.png";
import RRS from "@assets/images/projects/RRS.png";
import DT from "@assets/images/projects/DT.png";
import LinkButton from "./LinkButton.astro";
---

<div class="flex flex-col gap-20">
  <ProjectSection slug="/projects/unjspf" imgSRC={UNJSPF} imgALT="UNJSPF Alt Tag" title="United Nations Joint Staff Pension Fund">
    <p class="mb-[1lh]">I helped overhaul the UNJSPF’s web presence by identifying usability and workflow issues, improving content structure and accessibility, and delivering redesigned templates and admin tools that made content management easier for staff.</p>
    <LinkButton slug="/projects/unjspf" slot="LinkButton">Learn about the <abbr title="United Nations Joint Staff Pension Fund">UNJSPF</abbr> project</LinkButton>
  </ProjectSection>
  <hr class="text-indigo-200" />
  <ProjectSection imgSRC={RRS} imgALT="RRS Image Alt Tag" title="Redi-Rock Structures of OKI" reverse="true">
    <p class="mb-[1lh]">I led the end-to-end redesign of Redi-Rock Structures of OKI’s website—working on branding, UX, and content strategy to improve usability and sales support, and staying involved from kickoff through launch, training, and ongoing support.</p>
    <LinkButton slug="/projects/rrs" slot="LinkButton">Learn about the <abbr title="Redi-Rock Structures">RRS</abbr> project</LinkButton>
  </ProjectSection>
  <hr class="text-indigo-200" />
  <ProjectSection imgSRC={DT} imgALT="DeveloperTown Values Alt Tag" title="DeveloperTown Values">
    <p class="mb-[1lh]">I worked closely with designers to shape the site’s structure, accessibility, and content, built it with <a href="https://astro.build/" target="_blank">Astro</a> and <a href="https://tailwindcss.com/" target="_blank">Tailwind</a>, contributed to photo and drone shoots, and helped refine the copy along the way.</p>
    <LinkButton slug="/projects/dt-values" slot="LinkButton">Learn about the <abbr title="DeveloperTown">DT</abbr> Values project</LinkButton>
  </ProjectSection>
</div>
