---
const { title = "Chris Kraft", subtitle } = Astro.props;
---

<section class="flex flex-col justify-center align-middle aspect-3/1 bg-indigo-700">
  <div class="container mx-auto px-4 typography">
    <h1 class="text-white">{title}</h1>
    {subtitle && <p class="text-white text-2xl text-pretty w-full md:max-w-2xl md:mx-auto md:px-4 typography">{subtitle}</p>}
  </div>
</section>
