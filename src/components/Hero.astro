---
import { Image } from "astro:assets";
const { title = "Chris Kraft", subtitle, hero } = Astro.props;
---

<section class="relative flex flex-col justify-center align-middle aspect-3/1 bg-indigo-700 bg-center bg-no-repeat bg-cover">
  <div class="container mx-auto px-4 py-16 lg:py-0 typography relative z-30">
    <h1 class="text-white">{title}</h1>
    {subtitle && <p class="text-white text-2xl text-pretty w-full md:max-w-2xl md:mx-auto md:px-4 typography">{subtitle}</p>}
  </div>
  {hero && 
  <Image src={hero} class="object-cover grayscale blur-[1px] absolute z-10 h-full w-full" alt="" />
  <div class="bg-indigo-900 w-full h-full z-20 bg-blend-overlay opacity-90 absolute"></div>
  }
</section>
