import ProjectSection from "../components/ProjectSection.astro";
const title = "Projects";
---

<Page title={title}>
  <Hero title={title} />
  <main>
    <Section>
      <SectionHead title="Highlighted Work" />
    </Section>
    <Section>
      <SectionHead title="Additional Work" />
    </Section>
  </main>
</Page>
