---
import Section from "@components/Section.astro";
import SectionHead from "@components/SectionHead.astro";
import SectionSub from "@components/SectionSub.astro";
import Page from "@layouts/Page.astro";
const title = "Page Not Found";
---

<Page title={title}>
  <slot slot="HeadMeta">
    <meta name="description" content="Learn more about Chris Kraft — an accessibility-focused front-end developer and UX engineer with 25+ years of experience designing and building usable, inclusive web platforms." />

    <meta name="keywords" content="Chris Kraft, front-end developer, UX engineer, accessibility advocate, web accessibility, UX strategy, inclusive design, Astro, WordPress, WCAG" />

    <meta property="og:title" content="About Chris Kraft" />
    <meta property="og:description" content="Accessibility-focused front-end developer and UX engineer with 25+ years of experience building inclusive, usable web platforms." />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content="https://kriggity.com/about/" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="About Chris Kraft" />
    <meta name="twitter:description" content="Accessibility-focused front-end developer and UX engineer with 25+ years of experience building inclusive web platforms." />
  </slot>
  <Section>
    <SectionHead title="This page isn't available." />
    <SectionSub>
      <div class="typography">
        <p>The page you're looking for doesn't exist, or the link may be outdated. Either way, you're not lost.</p>
        <p>I design and build accessible, content-driven websites focused on clarity, usability, and real-world outcomes.</p>
      </div>
      <nav aria-label="Helpful links">
        <ul class="flex flex-col gap-1">
          <li class="box-border">
            <a href="/work/" class="inline-block py-3 pr-6 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black">View selected work</a>
          </li>
          <li class="box-border">
            <a href="/" class="inline-block py-3 pr-6 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black">Go to the home page</a>
          </li>
          <li class="box-border">
            <a href="/contact/" class="inline-block py-3 pr-6 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-black">Get in touch</a>
          </li>
        </ul>
      </nav>
    </SectionSub>
  </Section>
</Page>
