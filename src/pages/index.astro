---
import Page from "../layouts/Page.astro";
import Section from "../components/Section.astro";
import SectionHead from "../components/SectionHead.astro";
import { Image } from "astro:assets";
import ProjectSection from "../components/ProjectSection.astro";
import Organizations from "../components/Organizations.astro";
import thumbsUp from "../assets/images/thumbs up 05b.png";
import UNJSPF from "../assets/images/UNJSPF.jpg";
const title = "Chris Kraft, Interaction Designer and Accessibility Advocate";
---

<Page>
  <main>
    <section class="flex flex-col items-center px-4 py-16">
      <div class="flex flex-col sm:flex-row max-w-6xl gap-4 sm:gap-8 lg:gap-0">
        <div class="flex flex-col gap-8 w-full max-w-lg h-fit self-center">
          <h1 class="sr-only">The personal website of Chris Kraft, interaction designer and accessibility advocate.</h1>
          <div class="greeting-text text-indigo-900 font-serif font-extralight leading-[100%]">Hi, I'm <span class="font-normal">Chris</span></div>
          <div class="text-indigo-900 text-xl font-light leading-[150%]">I've been designing and building in the digital, internet, and print realms for over 26 years.</div>
        </div>
        <div class="ml-0 sm:-ml-16 lg:-ml-40">
          <Image src={thumbsUp} alt="Krig Thumbs Up" class="w-full max-w-2xl" />
        </div>
      </div>
    </section>
    <Section>
      <SectionHead title="Highlighted Projects" />
      <div class="flex flex-col gap-20">
        <ProjectSection slug="/projects/unjspf" imgSRC={UNJSPF} imgALT="UNJSPF Alt Tag" title="United Nations Joint Staff Pension Fund">
          <p>Addressed external and internal challenges with UNJSPF's fragmented and inefficient web presence.</p>
          <p>Conducted technical assessments and staff interviews to identify usability and workflow issues.</p>
          <p>Supported product designers in resolving content, usability, and accessibility problems.</p>
          <p>Implemented new content structure, page layouts, and functional templates based on tested designs.</p>
          <p>Delivered improved admin tools to empower staff with easier content management.</p>
        </ProjectSection>
        <hr class="text-indigo-200" />
        <ProjectSection slug="/projects/rrs" imgSRC={UNJSPF} imgALT="RRS Image Alt Tag" title="Redi-Rock Structures of OKI">
          <p>Led the full redesign of Redi-Rock Structures of OKI's website to improve sales support.</p>
          <p>Collaborated on branding, UI/UX, and content strategy.</p>
          <p>Helped define a refreshed brand identity and improve site organization and usability.</p>
          <p>Participated in every phase from kickoff to launch, plus training and ongoing support.</p>
        </ProjectSection>
        <hr class="text-indigo-200" />
        <ProjectSection slug="/projects/dt-values" imgSRC={UNJSPF} imgALT="DeveloperTown Values Alt Tag" title="DeveloperTown Values">
          <p>Collaborated with UI/UX designers on site structure, content organization, and responsive design.</p>
          <p>Ensured the interface met web accessibility standards.</p>
          <p>Developed the site using <a href="https://astro.build/" target="_blank">Astro</a> and <a href="https://tailwindcss.com/" target="_blank">Tailwind</a>.</p>
          <p>Participated in photo and video (including drone) shoots with the design team.</p>
          <p>Helped refine copywriting in coordination with designers and stakeholders.</p>
        </ProjectSection>
      </div>
    </Section>
    <Section>
      <SectionHead title="Organizations I've Worked With" />
      <Organizations />
    </Section>
  </main>
</Page>
<style>
  .greeting-text {
    font-size: 3rem;
    @media (width >= 40rem) {
      font-size: clamp(3.5rem, -1.5rem + 12.5vw, 4.5rem);
    }
    @media (width >= 48rem) {
      font-size: clamp(4.5rem, 3rem + 3.125vw, 5rem);
    }
  }
</style>
