---
import Page from "@layouts/Page.astro";
import Section from "@components/Section.astro";
import SectionHead from "@components/SectionHead.astro";
import SectionSub from "@components/SectionSub.astro";
import SectionSub2Col from "@components/SectionSub2Col.astro";
import Details from "@components/Details.astro";
import Image from "astro/components/Image.astro";

const title = "DeveloperTown Values";
import Hero from "@images/work/dtv/dt-hero-dot.jpg";
import Home from "@images/work/dtv/home.jpg";
import HomeMobile from "@images/work/dtv/home-mobile.jpg";
import Ownership from "@images/work/dtv/takeownership.jpg";
import OwnershipMobile from "@images/work/dtv/takeownership-mobile.jpg";
---

<Page title={title} hero={Hero}>
  <Section>
    <SectionHead title="Summary" />
    <div class="max-w-2xl mx-auto px-4 typography gap-4 flex flex-col flex-nowrap">
      <div class="text-pretty">
        <p><a href="https://developertown.com/" target="_blank">DeveloperTown</a> wanted to create a custom microsite to display its vision, mission, and values that was visually interesting and more engaging than a subsection of an About Us page. Working with content from our company-wide workshop, I collaborated with UX designers to design, author, and build the site. This was an exercise in creative design and then building that interface out using a (then) new website tool: <a href="https://astro.build/" target="_blank">Astro</a>.</p>
      </div>
      <div>
        <dl class="flex flex-row flex-nowrap gap-2">
          <dt class="text-indigo-900">Website:</dt>
          <dd><a href="https://values.developertown.com/" target="_blank">values.developertown.com</a></dd>
        </dl>
      </div>
    </div>
  </Section>
  <Section>
    <SectionHead title="Roles and Timeline" />
    <SectionSub>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Content Creation</h3>
        <div class="flex flex-col gap-10">
          <SectionSub2Col>
            <h4 slot="title">Photography and Video</h4>
            <p>I assisted with photography and video (including drone capture) sessions.</p>
          </SectionSub2Col>
          <SectionSub2Col>
            <h4 slot="title">Copywriting</h4>
            <p>I co-authored and refined the written content for the site.</p>
          </SectionSub2Col>
        </div>
      </Details>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Information Architecture and Content Strategy</h3>
        <p>I collaborated with the UX designers to organize the site content and arrange the information flow of each page template.</p>
      </Details>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Design Implementation and Technologies</h3>
        <div class="flex flex-col gap-10">
          <SectionSub2Col>
            <h4 slot="title">Astro</h4>
            <p>I created the site using the Astro framework and TailwindCSS. Astro allowed me to take advantage of reusable templates and components while building, and then created a fast and lightweight static site for deployment.</p>
          </SectionSub2Col>
          <SectionSub2Col>
            <h4 slot="title">Tailwind</h4>
            <p>I used <a href="https://tailwindcss.com/" target="_blank">Tailwind</a> as a compliment to Astro. The utility-first approach of Tailwind helped speed up building the base templates and styling. Tailwind's flexibility allowed me to create the customized angles of the UI as the layout changed across many viewport sizes. The optimized CSS output contributed to an overall lean build.</p>
          </SectionSub2Col>
        </div>
      </Details>
    </SectionSub>
  </Section>
  <Section>
    <SectionHead title="Results" />
    <SectionSub>
      <div class="flex flex-col lg:flex-row lg:flex-nowrap gap-8 lg:place-content-between">
        <div class="flex flex-row flex-nowrap gap-4">
          <div>
            <h3>Desktop</h3>
            <Image src={Home} alt="" class="lg:max-h-[860px] w-auto outline outline-indigo-100" />
          </div>
          <div>
            <h3>Mobile</h3>
            <Image src={HomeMobile} alt="" class="lg:max-h-[860px] w-auto outline outline-indigo-100" />
          </div>
        </div>
        <div class="flex flex-row flex-nowrap gap-4">
          <div>
            <h3>Desktop</h3>
            <Image src={Ownership} alt="" class="lg:max-h-[860px] w-auto outline outline-indigo-100" />
          </div>
          <div>
            <h3>Mobile</h3>
            <Image src={OwnershipMobile} alt="" class="lg:max-h-[860px] w-auto outline outline-indigo-100" />
          </div>
        </div>
      </div>
    </SectionSub>
  </Section>
</Page>
