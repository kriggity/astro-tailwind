---
import Page from "@layouts/Page.astro";
import Section from "@components/Section.astro";
import SectionHead from "@components/SectionHead.astro";
import SectionSub from "@components/SectionSub.astro";
import SectionSub2Col from "@components/SectionSub2Col.astro";
import Details from "@components/Details.astro";
import { Image } from "astro:assets";
import BrandGuidelines from "@images/work/rrs/BrandGuidelines.png";
import BrandGuidelinesPDF from "@assets/Brand Guidelines.pdf";
import Development from "@images/work/rrs/Development.jpg";
import Documentation from "@images/work/rrs/Documentation.jpg";
import HomeDesigns from "@images/work/rrs/HomeDesigns.jpg";
import Logos from "@images/work/rrs/Logos.png";
import Photography from "@images/work/rrs/Photography.png";
import Print2024 from "@images/work/rrs/Print2024.png";
import Prototype from "@images/work/rrs/Prototype.png";
import SiteOutline from "@images/work/rrs/SiteOutline.png";
import Template from "@images/work/rrs/Template.png";
import Workshop from "@images/work/rrs/RRS Workshop.jpg";
import HomeOld from "@images/work/rrs/home-old.jpg";
import HomeNew from "@images/work/rrs/home-new.jpg";
import Calendar2023_01 from "@images/work/rrs/Calendar2023-01.jpg";
import Calendar2023_02 from "@images/work/rrs/Calendar2023-02.jpg";
import Calendar2023_03 from "@images/work/rrs/Calendar2023-03.png";
import Calendar2024_01 from "@images/work/rrs/Calendar2024-01.jpg";
import Calendar2024_02 from "@images/work/rrs/Calendar2024-02.jpg";
import Calendar2024_03 from "@images/work/rrs/Calendar2024-03.jpg";

const title = "Redi-Rock Structures of O.K.I.";
const subtitle = "Rebuilding a Brand and Platform to Better Support Sales and Growth";
---

<Page title={title} subtitle={subtitle}>
  <Section>
    <SectionHead title="Summary" />
    <div class="max-w-2xl mx-auto typography flex flex-col gap-4">
      <p class="text-pretty">Redi-Rock Structures of O.K.I. needed a comprehensive refresh of its brand and website to better support sales, clarify complex product offerings, and present a more modern, professional presence.</p>
      <p class="text-pretty">
        Working in partnership with <a href="https://gretchensteward.crevado.com/" target="_blank">Gretchen Steward of intellifi UX</a>, I helped lead a structured effort spanning brand definition, content organization, and systemized WordPress implementation—ensuring the final result was not only visually updated, but scalable and maintainable.
      </p>
      <dl class="flex gap-2">
        <dt class="text-indigo-900">Website:</dt>
        <dd>
          <a href="https://redi-rockstructures.com" target="_blank"> redi-rockstructures.com </a>
        </dd>
      </dl>
    </div>
  </Section>
  <Section>
    <SectionHead title="Role & Scope" />
    <SectionSub>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">My Role</h3>
        <p>Co-led strategy and execution across branding, content structure, and front-end implementation. I focused on translating brand and UX decisions into a scalable WordPress system that supported sales, marketing, and ongoing content updates.</p>
      </Details>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Primary Goals</h3>
        <ul class="list-disc pl-6">
          <li>Clarify product offerings and use cases</li>
          <li>Support sales with consistent, reusable content</li>
          <li>Create a maintainable system for long-term growth</li>
        </ul>
      </Details>
    </SectionSub>
  </Section>
  <Section>
    <SectionHead title="Approach" />
    <SectionSub>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Brand Definition</h3>
        <div class="flex flex-col gap-6">
          <p>We facilitated a brand workshop with company leadership to align on positioning, voice, and target audiences. Outputs from this session guided visual design, copy tone, and content structure across all channels.</p>
          <Image src={Workshop} alt="Brand workshop in progress" />
        </div>
      </Details>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Brand System & Assets</h3>
        <div class="flex flex-col gap-10">
          <SectionSub2Col>
            <h4 slot="title">Identity & Guidelines</h4>
            <div class="flex flex-col gap-4">
              <p>
                Using the workshop findings, I explored logo refinements, color palettes, and typography before authoring comprehensive <a href={BrandGuidelinesPDF} target="_blank">brand guidelines</a> to codify usage across digital and print.
              </p>
              <Image src={Logos} alt="Logo refinements" />
              <Image src={BrandGuidelines} alt="Brand guidelines" />
            </div>
          </SectionSub2Col>
          <SectionSub2Col>
            <h4 slot="title">Print & Photography</h4>
            <div class="flex flex-col gap-4">
              <p>I updated key print collateral and helped direct a photography session to ensure visual consistency across marketing, sales, and web touchpoints.</p>
              <Image src={Print2024} alt="Updated print materials" />
              <Image src={Photography} alt="Photography from production facilities" />
            </div>
          </SectionSub2Col>
        </div>
      </Details>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Content & Information Architecture</h3>
        <div class="flex flex-col gap-10">
          <SectionSub2Col>
            <h4 slot="title">Site Structure</h4>
            <p>Content was reorganized to highlight products, applications, and real-world projects—drawing inspiration from the broader Redi-Rock ecosystem while tailoring structure to regional needs.</p>
            <Image src={SiteOutline} alt="Site structure outline" />
          </SectionSub2Col>
          <SectionSub2Col>
            <h4 slot="title">Page Templates</h4>
            <p>Page templates were designed to surface critical information quickly, with supporting content cross-linked to encourage exploration without overwhelming users.</p>
            <Image src={Template} alt="Page template structure" />
          </SectionSub2Col>
        </div>
      </Details>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Prototyping & Design Alignment</h3>
        <p>Interactive prototypes in Figma allowed stakeholders to validate navigation and structure early, reducing risk before visual design and development.</p>
        <Image src={Prototype} alt="Figma prototype" />
        <Image src={HomeDesigns} alt="UI design explorations" />
      </Details>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Development & Systems</h3>
        <div class="flex flex-col gap-4">
          <p>Using WordPress with Oxygen Builder, I created a system of global styles, templates, and reusable components that mirrored the design system and supported rapid content creation.</p>
          <p>Custom admin tools allowed non-technical users to manage team members, timelines, products, and project case studies through structured metadata rather than manual layout work.</p>
          <Image src={Development} alt="WordPress development" />
        </div>
      </Details>
      <Details>
        <h3 slot="summaryTitle" class="mb-0">Documentation & Enablement</h3>
        <p>I embedded technical documentation directly within the WordPress admin, ensuring guidance lived alongside the tools themselves and reduced reliance on external docs.</p>
        <Image src={Documentation} alt="Internal documentation" />
      </Details>
    </SectionSub>
  </Section>
  <Section>
    <SectionHead title="Results" />
    <SectionSub>
      <div class="flex flex-col gap-16">
        <div>
          <h3>Website Refresh</h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <h4>Before</h4>
              <Image src={HomeOld} alt="Old homepage" class="outline outline-indigo-100" />
            </div>
            <div>
              <h4>After</h4>
              <Image src={HomeNew} alt="New homepage" class="outline outline-indigo-100" />
            </div>
          </div>
        </div>
        <div>
          <h3>Print Calendar</h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <h4>Before</h4>
              <Image src={Calendar2023_01} alt="2023 calendar" />
              <Image src={Calendar2023_02} alt="2023 calendar interior" />
              <Image src={Calendar2023_03} alt="2023 calendar grid" />
            </div>
            <div>
              <h4>After</h4>
              <Image src={Calendar2024_01} alt="2024 calendar" />
              <Image src={Calendar2024_02} alt="2024 calendar interior" />
              <Image src={Calendar2024_03} alt="2024 calendar grid" />
            </div>
          </div>
        </div>
      </div>
    </SectionSub>
  </Section>
</Page>
